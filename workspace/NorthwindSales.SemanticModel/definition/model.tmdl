model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Customers", "Orders", "Products", "Order_Details"]

ref table Customers
ref table Orders
ref table Products
ref table Order_Details
ref cultureInfo en-US
