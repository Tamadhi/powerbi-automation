relationship Order_Details_Orders
    fromCardinality: many
    toCardinality: one
    fromColumn: Order_Details.OrderID
    toColumn: Orders.OrderID

relationship Order_Details_Products
    fromCardinality: many
    toCardinality: one
    fromColumn: Order_Details.ProductID
    toColumn: Products.ProductID

relationship Orders_Customers
    fromCardinality: many
    toCardinality: one
    fromColumn: Orders.CustomerID
    toColumn: Customers.CustomerID
